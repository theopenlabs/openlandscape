# Copy to .env (local) or /etc/openpipeline.env (server). Never commit the real file.
PORT=8080
NODE_ENV=production
PUBLIC_URL=https://openlandscape.app                # public site, no trailing slash
DASHBOARD_URL=https://dashboard.openlandscape.app   # leave empty locally: dashboard is then at /app
COOKIE_DOMAIN=openlandscape.app                     # shares sign-in between the two addresses; empty locally
BRAND=OpenLandscape

# Stripe (test keys start sk_test_, live keys sk_live_). Dashboard -> Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                     # webhook endpoint: https://<domain>/billing/webhook
STRIPE_PRICE_SOLO=price_...                         # product OpenLandscape Solo, $49 a month excl. VAT (offers yearly at checkout); empty = price made inline
STRIPE_PRICE_SOLO_YEAR=price_...                    # same product, $490 a year excl. VAT
                                                    # events: checkout.session.completed, checkout.session.async_payment_succeeded, customer.subscription.updated, customer.subscription.deleted
                                                    # Stripe Tax must be on first (Estonia registration, origin address), and a
                                                    # Terms link in Settings -> Public details: checkout asks people to agree to it.
# Email sign-in links (Resend). Without it, links are printed to the server log (local only).
RESEND_API_KEY=re_...
MAIL_FROM=OpenLandscape <signin@openlandscape.app>
# Weekly email (Mondays from 07:00 UTC). Empty = nobody gets it; a comma list of emails; or "all".
DIGEST_TO=
DIGEST_FROM=OpenLandscape <updates@openlandscape.app>

# "Continue with Google" (optional). Without both, the Google button is hidden.
# Google Cloud -> Google Auth Platform -> Clients. Redirect URI: <DASHBOARD_URL>/auth/google/callback
# (locally http://localhost:8080/auth/google/callback). Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin pages for scripts: send "Authorization: Bearer <token>". At least 32 characters; this placeholder never works.
ADMIN_TOKEN=change-me-to-a-long-random-string
ADMIN_EMAILS=you@your-domain                        # accounts that can open /admin (comma list); anyone else gets Not found
CONTACT_EMAIL=you@your-domain                       # "Report a wrong row" link
REPO_URL=                                           # https://github.com/theopenlabs/openlandscape, set this only once the repo is public (private repos show visitors a 404)

# MCP connector sign-in (src/oauth.js) needs no keys: it uses PUBLIC_URL as its address.
# Directory reviewers sign in with a fixed code instead of an email link. Both set = on; remove to turn off.
# The account gets the Solo plan. The code must be 12+ characters.
REVIEWER_EMAIL=
REVIEWER_CODE=
# ChatGPT directory: OpenAI's domain check reads this token at /.well-known/openai-apps-challenge (empty = 404).
OPENAI_APPS_CHALLENGE=
# Cards in Claude and ChatGPT (src/cards.js): on unless this is 0. 0 = text answers only.
AI_CARDS=
# Once the listings are live, the setup box adds "Or add it from the app's directory" with these links; empty = no line.
CLAUDE_CONNECTOR_URL=                               # e.g. https://claude.ai/directory/<id>
CHATGPT_APP_URL=                                    # e.g. https://chatgpt.com/plugins/<id>
